# Copy to .env on the GPU machine:  cp env.example .env   (the real .env is gitignored — never commit it)

# Shared bearer key for all three servers. core-api sends it as CHATBOT_SELFHOSTED_API_KEY.
# Generate: openssl rand -hex 32
LLM_API_KEY=

# Address the ports listen on. Prefer the machine's private/LAN IP over 0.0.0.0,
# and firewall 8080-8082/5001 to the core-api server only (see README).
BIND_ADDR=0.0.0.0

# ── Profile A (default): best answers. Qwen3-8B on GPU, reranker on CPU. ~6.9 GB VRAM ──
COMPOSE_PROFILES=rerank-cpu
CHAT_MODEL=Qwen/Qwen3-8B-GGUF:Q4_K_M
CHAT_MODEL_ALIAS=qwen3-8b
CHAT_CTX=8192

# ── Profile B: faster, more headroom. Qwen3-4B on GPU, reranker on GPU. ~5.2 GB VRAM ──
# COMPOSE_PROFILES=rerank-gpu
# CHAT_MODEL=unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_K_M
# CHAT_MODEL_ALIAS=qwen3-4b-instruct
# CHAT_CTX=16384

# Add the document parser on this machine too:  COMPOSE_PROFILES=rerank-cpu,docling

EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
EMBED_MODEL_ALIAS=qwen3-embedding-0.6b
RERANK_MODEL=gpustack/bge-reranker-v2-m3-GGUF:Q8_0
RERANK_MODEL_ALIAS=bge-reranker-v2-m3

# Pin images to a tested build once it works (e.g. ghcr.io/ggml-org/llama.cpp:server-cuda-bXXXX).
LLAMA_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Only needed if a model repo is gated on Hugging Face.
HF_TOKEN=
