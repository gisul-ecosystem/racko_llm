# Copy to .env on the GPU machine:  cp env.example .env && chmod 600 .env
# The real .env and secrets/ are gitignored — never commit them.
#
# The model API key is NOT here: it lives in secrets/llm_api_key (see README step 3).

# REQUIRED. The IP the ports listen on.
#   With the Cloudflare Tunnel (default): 127.0.0.1 — core-api reaches the models only through
#   https://llm.racko.ai, and nothing listens on the office network.
#   Without the tunnel: this machine's private LAN or WireGuard IP. Never 0.0.0.0 (Docker bypasses ufw).
BIND_ADDR=127.0.0.1

# Public URL of the tunnel (used by ./smoke-test.sh --public).
LLM_PUBLIC_URL=https://llm.racko.ai
# Written by ./tunnel-setup.sh (one-time Cloudflare login + tunnel + DNS). Leave empty until then.
CLOUDFLARED_TUNNEL_ID=

# ── Profile A (default): best answers. Qwen3-8B on GPU, reranker on CPU. ──
# Measured on an RTX 3060 Ti with a desktop session: 7.3 of 8.2 GB used (CHAT_CTX=6144).
# Add `tunnel` once ./tunnel-setup.sh has run:  COMPOSE_PROFILES=rerank-cpu,tunnel
COMPOSE_PROFILES=rerank-cpu
CHAT_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
CHAT_MODEL_ALIAS=qwen3-8b
CHAT_CTX=6144
RERANK_CPUS=4

# ── Profile B: faster, more headroom. Qwen3-4B on GPU, reranker on GPU. ~5.2 GB VRAM ──
# COMPOSE_PROFILES=rerank-gpu,tunnel
# CHAT_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# CHAT_MODEL_ALIAS=qwen3-4b-instruct
# CHAT_CTX=16384

EMBED_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBED_MODEL_ALIAS=qwen3-embedding-0.6b
RERANK_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf
RERANK_MODEL_ALIAS=bge-reranker-v2-m3
# Every *_MODEL_FILE must be listed in models.lock (exact file + SHA-256).

# ── Optional extras: append to COMPOSE_PROFILES, e.g. COMPOSE_PROFILES=rerank-cpu,tunnel,monitoring ──
# docling    — document parser (better on the app server: CPU-only, and big PDFs can exceed Cloudflare's 100 s limit)
# monitoring — GPU metrics exporter on :9835
# Key core-api sends as X-Api-Key (DOCLING_API_KEY there). Generate: openssl rand -hex 32
DOCLING_API_KEY=
DOCLING_CPUS=4
DOCLING_MEM=6g

# Only needed if a model repo becomes gated on Hugging Face.
HF_TOKEN=
